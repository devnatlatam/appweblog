# Copia este archivo a .env y completa los valores. El .env real NO se sube a ningún repositorio.

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_syslog
DB_USER=syslogweb
DB_PASSWORD=cambia-esta-clave

# Clave para firmar las sesiones. Genera una nueva para cada instalación:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Puerto de la API y dirección donde escucha. En producción déjala en 127.0.0.1: solo nginx debe verla.
PORT=4000
HOST=127.0.0.1

# Zona horaria que define dónde empieza y termina cada día (borrado por días)
APP_TIMEZONE=America/Lima

# Disco que se vigila para el borrado por porcentaje. Si el usuario de la base no es superusuario,
# hay que indicar aquí la carpeta de datos de PostgreSQL (en Debian: /var/lib/postgresql).
DISK_PATH=/var/lib/postgresql

# Que la web abra y cierre los puertos de los clientes en el firewall (ufw). Requiere la instalación del paso 10.2 de
# DESPLIEGUE.md. Déjalo en none si administras el firewall a mano (por ejemplo, en desarrollo).
FIREWALL_DRIVER=none
# FIREWALL_DIR=/var/lib/syslogweb

# Solo para importar archivos antiguos con "npm run ingest"
LOGS_DIR=./logs
INGEST_POLL_MS=3000
